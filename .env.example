# Copy to .env and fill in. Never commit .env.

# Model for Cravio and its subagents (provider:model)
CRAVIO_MODEL=ollama:gemma4:26b
# For a hosted model instead: CRAVIO_MODEL=<provider>:<model>, plus that provider's API key

# Ollama only: context window in tokens, and whether the model thinks before answering
OLLAMA_NUM_CTX=32768
OLLAMA_THINK=true

# Which Swiggy MCP servers the agent uses: food, im (Instamart), dineout
SWIGGY_SERVERS=food,im
SWIGGY_OAUTH_CALLBACK_PORT=3030

# LangSmith tracing, off unless true. Personal data is masked on this machine before upload
# (src/cravio/pii.py). Never set LANGSMITH_TRACING: Cravio refuses to run with it.
CRAVIO_LANGSMITH=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cravio
# Extra words to mask in traces, comma-separated: your name, building, flat number
CRAVIO_PII_TERMS=

# How long Ollama keeps the model loaded between questions (it unloads after 5 idle minutes by default)
OLLAMA_KEEP_ALIVE=2h
